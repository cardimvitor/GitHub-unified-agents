{
  "expo": {
    "name": "Unified Agents",
    "slug": "github-unified-agents",
    "version": "0.1.0",
    "scheme": "unifiedagents",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#101827"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardimvitor.unifiedagents"
    },
    "android": {
      "package": "com.cardimvitor.unifiedagents",
      "permissions": [
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "softwareKeyboardLayoutMode": "resize"
    }
  }
}
